{
    "app-id": "pro.lasne.luca",
    "runtime": "io.elementary.Platform",
    "runtime-version": "8",
    "sdk": "io.elementary.Sdk",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
    "command": "luca",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "modules": [{
        "name": "luca",
        "buildsystem": "simple",
        "build-options": {
            "env": {
                "CARGO_HOME": "/run/build/luca/cargo"
            }
        },
        "build-commands": [
            "cargo --offline fetch --manifest-path Cargo.toml --verbose",
            "cargo --offline build --release --verbose",
            "install -Dm644 ./data/pro.lasne.luca.desktop -t /app/share/applications/",
            "install -Dm644 ./data/pro.lasne.luca.appdata.xml -t /app/share/appdata/",
            "install -Dm755 ./target/release/luca -t /app/bin/"
        ],
        "sources": [{
                "type": "dir",
                "path": "."
            },
            "cargo-sources.json"
        ]
    }]
}
